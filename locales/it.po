msgid ""
msgstr ""
"Project-Id-Version: note-history-diff\n"
"Report-Msgid-Bugs-To: https://github.com/akiratamcat/joplin-plugin-note-history-diff/issues\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/ui/i18n.ts:100
#. One entry of the version list: {name} is "Revision <date>" or "Current note", {size} its length or "cannot be read".
msgid "{name} ({size})"
msgstr "{name} ({size})"

#: src/ui/i18n.ts:101
msgid "cannot be read"
msgstr "non leggibile"

#: src/ui/i18n.ts:102
msgid "The same version is selected on both sides."
msgstr "La stessa versione è selezionata su entrambi i lati."

#: src/ui/i18n.ts:103
msgid "Side by side"
msgstr "Affiancato"

#: src/ui/i18n.ts:105
#. The one-column layout of the diff.
msgid "Unified"
msgstr "Unificato"

#: src/ui/i18n.ts:106
msgid "◀ Older pair"
msgstr "◀ Coppia precedente"

#: src/ui/i18n.ts:107
msgid "Newer pair ▶"
msgstr "Coppia successiva ▶"

#: src/ui/i18n.ts:108
msgid "↑ Previous change"
msgstr "↑ Modifica precedente"

#: src/ui/i18n.ts:109
msgid "↓ Next change"
msgstr "↓ Modifica successiva"

#: src/ui/i18n.ts:110
msgid "Ignore trailing spaces and line endings"
msgstr "Ignora gli spazi a fine riga e i caratteri di fine riga"

#: src/ui/i18n.ts:111
msgid "Comparing the latest revision with the current note."
msgstr "Confronto tra l'ultima versione e la nota attuale."

#: src/ui/i18n.ts:112
msgid "The note has not changed since the latest revision, so it is compared with the revision before it."
msgstr "La nota non è cambiata dall'ultima versione, quindi viene confrontata con la versione precedente."

#: src/ui/i18n.ts:114
#. Number of lines added and removed in the diff.
msgid "+{added} / −{removed} lines"
msgstr "+{added} / −{removed} righe"

#: src/ui/i18n.ts:116
#. Heading of the diff of the note title.
msgid "Title"
msgstr "Titolo"

#: src/ui/i18n.ts:117
msgid "Body: no changes"
msgstr "Testo: nessuna modifica"

#: src/ui/i18n.ts:119
#. Shown in place of unchanged lines that are folded away.
msgid "… {count} unchanged line …"
msgid_plural "… {count} unchanged lines …"
msgstr[0] "… {count} riga invariata …"
msgstr[1] "… {count} righe invariate …"

#: src/ui/i18n.ts:121
#. Item of the right-click menu in the history diff.
msgid "Copy"
msgstr "Copia"

#: src/ui/i18n.ts:122
msgid "Font size of the diff"
msgstr "Dimensione del carattere delle differenze"

#: src/ui/i18n.ts:124
#. Description of the setting above. {min} and {max} are numbers; "Editor" is the section of Joplin's options.
msgid "In pixels, from {min} to {max}. 0 uses the editor font size set in the Editor section of the options."
msgstr "In pixel, da {min} a {max}. 0 usa la dimensione del carattere dell'editor impostata nella sezione \"Editor\" delle opzioni."

#: src/ui/i18n.ts:125
msgid "Unchanged lines kept around each change"
msgstr "Righe invariate mantenute attorno a ogni modifica"

#: src/ui/i18n.ts:127
#. Choice of the setting above: show every unchanged line.
msgid "Do not fold"
msgstr "Non comprimere"

#: src/ui/i18n.ts:128
msgid "Highlight the changed characters inside changed lines"
msgstr "Evidenzia i caratteri modificati nelle righe modificate"

#: src/ui/i18n.ts:129
msgid "Layout when the history diff opens"
msgstr "Layout all'apertura delle differenze della cronologia"

#: src/ui/i18n.ts:131
#. Choice of the setting above: the layout chosen last time.
msgid "Last used"
msgstr "L'ultimo usato"

#: src/ui/i18n.ts:132
msgid "Wrap long lines"
msgstr "A capo per le righe lunghe"

#: src/ui/i18n.ts:74
msgid "Show note history diff"
msgstr "Mostra le differenze della cronologia della nota"

#: src/ui/i18n.ts:75
msgid "Note History Diff works in the main window only. Open the note in the main window to see its history."
msgstr "Note History Diff funziona solo nella finestra principale. Apri la nota nella finestra principale per vederne la cronologia."

#: src/ui/i18n.ts:76
msgid "Refresh"
msgstr "Aggiorna"

#: src/ui/i18n.ts:77
msgid "Close"
msgstr "Chiudi"

#: src/ui/i18n.ts:78
msgid "Loading note history…"
msgstr "Caricamento della cronologia della nota…"

#: src/ui/i18n.ts:79
msgid "Select a note to see its changes."
msgstr "Seleziona una nota per vederne le modifiche."

#: src/ui/i18n.ts:80
msgid "This note has no history yet."
msgstr "Questa nota non ha ancora una cronologia."

#: src/ui/i18n.ts:82
#. {interval} is a number of minutes, {days} a number of days (Joplin's note history settings).
msgid "Joplin saves a revision when the note is changed at least {interval} minutes after the previous revision, and keeps it for {days} days."
msgstr "Joplin salva una versione quando la nota viene modificata almeno {interval} minuti dopo la versione precedente e la conserva per {days} giorni."

#: src/ui/i18n.ts:83
msgid "Note history is turned off. You can turn it on in Tools > Options > Note History."
msgstr "La cronologia delle note è disattivata. Puoi attivarla in Strumenti > Opzioni > Cronologia note."

#: src/ui/i18n.ts:84
msgid "The only revision is identical to the current note, so there is nothing to compare yet."
msgstr "L'unica versione è identica alla nota attuale, quindi non c'è ancora nulla da confrontare."

#: src/ui/i18n.ts:85
msgid "A revision is still encrypted, so its content cannot be rebuilt."
msgstr "Una versione è ancora crittografata, quindi il suo contenuto non può essere ricostruito."

#: src/ui/i18n.ts:87
#. {reason} is a technical code such as "invalid-patch"; keep it as it is.
msgid "A revision could not be read ({reason})."
msgstr "Impossibile leggere una versione ({reason})."

#: src/ui/i18n.ts:89
#. {message} is an error message, usually in English.
msgid "Something went wrong: {message}"
msgstr "Si è verificato un errore: {message}"

#: src/ui/i18n.ts:91
#. Label of the list of the older version to compare.
msgid "From"
msgstr "Da"

#: src/ui/i18n.ts:93
#. Label of the list of the newer version to compare.
msgid "To"
msgstr "A"

#: src/ui/i18n.ts:95
#. A saved revision of the note in the version list. {time} is its date and time.
msgid "Revision {time}"
msgstr "Versione {time}"

#: src/ui/i18n.ts:96
msgid "Current note"
msgstr "Nota attuale"

#: src/ui/i18n.ts:98
#. Length of a version in the version list. {count} is a formatted number.
msgid "{count} char"
msgid_plural "{count} chars"
msgstr[0] "{count} carattere"
msgstr[1] "{count} caratteri"
