msgid ""
msgstr ""
"Project-Id-Version: note-history-diff\n"
"Report-Msgid-Bugs-To: https://github.com/akiratamcat/joplin-plugin-note-history-diff/issues\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#: src/ui/i18n.ts:100
msgid "Comparing the latest revision with the current note."
msgstr "Comparando a versão mais recente com a nota atual."

#: src/ui/i18n.ts:101
msgid "The note has not changed since the latest revision, so it is compared with the revision before it."
msgstr "A nota não mudou desde a versão mais recente, então ela é comparada com a versão anterior."

#: src/ui/i18n.ts:103
#. Number of lines added and removed in the diff.
msgid "+{added} / −{removed} lines"
msgstr "+{added} / −{removed} linhas"

#: src/ui/i18n.ts:105
#. Heading of the diff of the note title.
msgid "Title"
msgstr "Título"

#: src/ui/i18n.ts:106
msgid "Body: no changes"
msgstr "Corpo: sem alterações"

#: src/ui/i18n.ts:108
#. Shown in place of unchanged lines that are folded away.
msgid "… {count} unchanged line …"
msgid_plural "… {count} unchanged lines …"
msgstr[0] "… {count} linha sem alterações …"
msgstr[1] "… {count} linhas sem alterações …"

#: src/ui/i18n.ts:63
msgid "Show note history diff"
msgstr "Mostrar diferenças do histórico da nota"

#: src/ui/i18n.ts:64
msgid "Note History Diff works in the main window only. Open the note in the main window to see its history."
msgstr "O Note History Diff funciona apenas na janela principal. Abra a nota na janela principal para ver o histórico."

#: src/ui/i18n.ts:65
msgid "Refresh"
msgstr "Atualizar"

#: src/ui/i18n.ts:66
msgid "Close"
msgstr "Fechar"

#: src/ui/i18n.ts:67
msgid "Loading note history…"
msgstr "Carregando o histórico da nota…"

#: src/ui/i18n.ts:68
msgid "Select a note to see its changes."
msgstr "Selecione uma nota para ver as alterações."

#: src/ui/i18n.ts:69
msgid "This note has no history yet."
msgstr "Esta nota ainda não tem histórico."

#: src/ui/i18n.ts:71
#. {interval} is a number of minutes, {days} a number of days (Joplin's note history settings).
msgid "Joplin saves a revision when the note is changed at least {interval} minutes after the previous revision, and keeps it for {days} days."
msgstr "O Joplin salva uma versão quando a nota é alterada pelo menos {interval} minutos após a versão anterior e a mantém por {days} dias."

#: src/ui/i18n.ts:72
msgid "Note history is turned off. You can turn it on in Tools > Options > Note History."
msgstr "O histórico de notas está desativado. Você pode ativá-lo em Ferramentas > Opções > Histórico de notas."

#: src/ui/i18n.ts:73
msgid "The only revision is identical to the current note, so there is nothing to compare yet."
msgstr "A única versão é idêntica à nota atual, então ainda não há nada para comparar."

#: src/ui/i18n.ts:74
msgid "A revision is still encrypted, so its content cannot be rebuilt."
msgstr "Uma versão ainda está criptografada, então o conteúdo não pode ser reconstruído."

#: src/ui/i18n.ts:76
#. {reason} is a technical code such as "invalid-patch"; keep it as it is.
msgid "A revision could not be read ({reason})."
msgstr "Não foi possível ler uma versão ({reason})."

#: src/ui/i18n.ts:78
#. {message} is an error message, usually in English.
msgid "Something went wrong: {message}"
msgstr "Algo deu errado: {message}"

#: src/ui/i18n.ts:80
#. Label of the list of the older version to compare.
msgid "From"
msgstr "De"

#: src/ui/i18n.ts:82
#. Label of the list of the newer version to compare.
msgid "To"
msgstr "Para"

#: src/ui/i18n.ts:84
#. A saved revision of the note in the version list. {time} is its date and time.
msgid "Revision {time}"
msgstr "Versão {time}"

#: src/ui/i18n.ts:85
msgid "Current note"
msgstr "Nota atual"

#: src/ui/i18n.ts:87
#. Length of a version in the version list. {count} is a formatted number.
msgid "{count} char"
msgid_plural "{count} chars"
msgstr[0] "{count} caractere"
msgstr[1] "{count} caracteres"

#: src/ui/i18n.ts:89
#. One entry of the version list: {name} is "Revision <date>" or "Current note", {size} its length or "cannot be read".
msgid "{name} ({size})"
msgstr "{name} ({size})"

#: src/ui/i18n.ts:90
msgid "cannot be read"
msgstr "não pode ser lida"

#: src/ui/i18n.ts:91
msgid "The same version is selected on both sides."
msgstr "A mesma versão está selecionada nos dois lados."

#: src/ui/i18n.ts:92
msgid "Side by side"
msgstr "Lado a lado"

#: src/ui/i18n.ts:94
#. The one-column layout of the diff.
msgid "Unified"
msgstr "Unificado"

#: src/ui/i18n.ts:95
msgid "◀ Older pair"
msgstr "◀ Par anterior"

#: src/ui/i18n.ts:96
msgid "Newer pair ▶"
msgstr "Próximo par ▶"

#: src/ui/i18n.ts:97
msgid "↑ Previous change"
msgstr "↑ Alteração anterior"

#: src/ui/i18n.ts:98
msgid "↓ Next change"
msgstr "↓ Próxima alteração"

#: src/ui/i18n.ts:99
msgid "Ignore trailing spaces and line endings"
msgstr "Ignorar espaços no fim da linha e quebras de linha"
