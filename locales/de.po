msgstr ""
"Project-Id-Version: note-history-diff\n"
"Report-Msgid-Bugs-To: https://github.com/akiratamcat/joplin-plugin-note-history-diff/issues\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/ui/i18n.ts:100
#. One entry of the version list: {name} is "Revision <date>" or "Current note", {size} its length or "cannot be read".
msgid "{name} ({size})"
msgstr "{name} ({size})"

#: src/ui/i18n.ts:101
msgid "cannot be read"
msgstr "nicht lesbar"

#: src/ui/i18n.ts:102
msgid "The same version is selected on both sides."
msgstr "Auf beiden Seiten ist dieselbe Version ausgewählt."

#: src/ui/i18n.ts:103
msgid "Side by side"
msgstr "Nebeneinander"

#: src/ui/i18n.ts:105
#. The one-column layout of the diff.
msgid "Unified"
msgstr "Einspaltig"

#: src/ui/i18n.ts:106
msgid "◀ Older pair"
msgstr "◀ Älteres Paar"

#: src/ui/i18n.ts:107
msgid "Newer pair ▶"
msgstr "Neueres Paar ▶"

#: src/ui/i18n.ts:108
msgid "↑ Previous change"
msgstr "↑ Vorherige Änderung"

#: src/ui/i18n.ts:109
msgid "↓ Next change"
msgstr "↓ Nächste Änderung"

#: src/ui/i18n.ts:110
msgid "Ignore trailing spaces and line endings"
msgstr "Leerzeichen am Zeilenende und Zeilenumbrüche ignorieren"

#: src/ui/i18n.ts:111
msgid "Comparing the latest revision with the current note."
msgstr "Die neueste Version wird mit der aktuellen Notiz verglichen."

#: src/ui/i18n.ts:112
msgid "The note has not changed since the latest revision, so it is compared with the revision before it."
msgstr "Die Notiz hat sich seit der neuesten Version nicht geändert, daher wird sie mit der Version davor verglichen."

#: src/ui/i18n.ts:114
#. Number of lines added and removed in the diff.
msgid "+{added} / −{removed} lines"
msgstr "+{added} / −{removed} Zeilen"

#: src/ui/i18n.ts:116
#. Heading of the diff of the note title.
msgid "Title"
msgstr "Titel"

#: src/ui/i18n.ts:117
msgid "Body: no changes"
msgstr "Text: keine Änderungen"

#: src/ui/i18n.ts:119
#. Shown in place of unchanged lines that are folded away.
msgid "… {count} unchanged line …"
msgid_plural "… {count} unchanged lines …"
msgstr[0] "… {count} unveränderte Zeile …"
msgstr[1] "… {count} unveränderte Zeilen …"

#: src/ui/i18n.ts:121
#. Item of the right-click menu in the history diff.
msgid "Copy"
msgstr "Kopieren"

#: src/ui/i18n.ts:122
msgid "Font size of the diff"
msgstr "Schriftgröße der Unterschiede"

#: src/ui/i18n.ts:124
#. Description of the setting above. {min} and {max} are numbers; "Editor" is the section of Joplin's options.
msgid "In pixels, from {min} to {max}. 0 uses the editor font size set in the Editor section of the options."
msgstr "In Pixeln, von {min} bis {max}. 0 verwendet die Schriftgröße des Editors aus dem Abschnitt „Editor“ der Optionen."

#: src/ui/i18n.ts:125
msgid "Unchanged lines kept around each change"
msgstr "Unveränderte Zeilen um jede Änderung"

#: src/ui/i18n.ts:127
#. Choice of the setting above: show every unchanged line.
msgid "Do not fold"
msgstr "Nicht einklappen"

#: src/ui/i18n.ts:128
msgid "Highlight the changed characters inside changed lines"
msgstr "Geänderte Zeichen in geänderten Zeilen hervorheben"

#: src/ui/i18n.ts:129
msgid "Layout when the history diff opens"
msgstr "Layout beim Öffnen der Verlaufsunterschiede"

#: src/ui/i18n.ts:131
#. Choice of the setting above: the layout chosen last time.
msgid "Last used"
msgstr "Zuletzt verwendet"

#: src/ui/i18n.ts:132
msgid "Wrap long lines"
msgstr "Lange Zeilen umbrechen"

#: src/ui/i18n.ts:74
msgid "Show note history diff"
msgstr "Unterschiede im Notizverlauf anzeigen"

#: src/ui/i18n.ts:75
msgid "Note History Diff works in the main window only. Open the note in the main window to see its history."
msgstr "Note History Diff funktioniert nur im Hauptfenster. Öffnen Sie die Notiz im Hauptfenster, um ihren Verlauf zu sehen."

#: src/ui/i18n.ts:76
msgid "Refresh"
msgstr "Aktualisieren"

#: src/ui/i18n.ts:77
msgid "Close"
msgstr "Schließen"

#: src/ui/i18n.ts:78
msgid "Loading note history…"
msgstr "Notizverlauf wird geladen…"

#: src/ui/i18n.ts:79
msgid "Select a note to see its changes."
msgstr "Wählen Sie eine Notiz aus, um ihre Änderungen zu sehen."

#: src/ui/i18n.ts:80
msgid "This note has no history yet."
msgstr "Diese Notiz hat noch keinen Verlauf."

#: src/ui/i18n.ts:82
#. {interval} is a number of minutes, {days} a number of days (Joplin's note history settings).
msgid "Joplin saves a revision when the note is changed at least {interval} minutes after the previous revision, and keeps it for {days} days."
msgstr "Joplin speichert eine Version, wenn die Notiz mindestens {interval} Minuten nach der vorherigen Version geändert wird, und behält sie {days} Tage lang."

#: src/ui/i18n.ts:83
msgid "Note history is turned off. You can turn it on in Tools > Options > Note History."
msgstr "Der Notizverlauf ist ausgeschaltet. Sie können ihn unter Werkzeuge > Optionen > Notizverlauf einschalten."

#: src/ui/i18n.ts:84
msgid "The only revision is identical to the current note, so there is nothing to compare yet."
msgstr "Die einzige Version ist identisch mit der aktuellen Notiz, daher gibt es noch nichts zu vergleichen."

#: src/ui/i18n.ts:85
msgid "A revision is still encrypted, so its content cannot be rebuilt."
msgstr "Eine Version ist noch verschlüsselt, daher kann ihr Inhalt nicht wiederhergestellt werden."

#: src/ui/i18n.ts:87
#. {reason} is a technical code such as "invalid-patch"; keep it as it is.
msgid "A revision could not be read ({reason})."
msgstr "Eine Version konnte nicht gelesen werden ({reason})."

#: src/ui/i18n.ts:89
#. {message} is an error message, usually in English.
msgid "Something went wrong: {message}"
msgstr "Ein Fehler ist aufgetreten: {message}"

#: src/ui/i18n.ts:91
#. Label of the list of the older version to compare.
msgid "From"
msgstr "Von"

#: src/ui/i18n.ts:93
#. Label of the list of the newer version to compare.
msgid "To"
msgstr "Mit"

#: src/ui/i18n.ts:95
#. A saved revision of the note in the version list. {time} is its date and time.
msgid "Revision {time}"
msgstr "Version {time}"

#: src/ui/i18n.ts:96
msgid "Current note"
msgstr "Aktuelle Notiz"

#: src/ui/i18n.ts:98
#. Length of a version in the version list. {count} is a formatted number.
msgid "{count} char"
msgid_plural "{count} chars"
msgstr[0] "{count} Zeichen"
msgstr[1] "{count} Zeichen"
